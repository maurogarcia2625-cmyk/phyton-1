def pedir_monto_valido():
    while True:
        try:
            monto = float(input("Monto ($): "))
            if monto <= 0:
                print("Error: El monto debe ser mayor a $0.00. Intenta de nuevo.")
            else:
                return monto
        except ValueError:
            print("Error: Entrada inválida. Por favor, ingresa un número (ej. 12.50).")


def pedir_texto_no_vacio(mensaje):
    while True:
        texto = input(mensaje).strip()
        if texto:
            return texto
        print("Error: Este campo no puede estar vacío.")


def agregar_gasto(gastos):
    print("\n--- REGISTRAR NUEVO GASTO ---")
    descripcion = pedir_texto_no_vacio("Descripción del gasto: ")
    monto = pedir_monto_valido()
    
    categoria = pedir_texto_no_vacio("Categoría (Comida/Transporte/Ocio/Otros): ").capitalize()

    nuevo_gasto = {
        "descripcion": descripcion,
        "monto": monto,
        "categoria": categoria
    }

    gastos.append(nuevo_gasto)
    print("-> Gasto registrado con éxito.")


def mostrar_gastos(gastos):
    print("\n--- LISTA DE GASTOS ---")
    if not gastos:
        print("No hay gastos registrados todavía.")
        return

    for indice, gasto in enumerate(gastos, start=1):
        print(f"{indice}. {gasto['descripcion']} | ${gasto['monto']:.2f} | [{gasto['categoria']}]")


def filtrar_por_categoria(gastos):
    print("\n--- FILTRAR POR CATEGORÍA ---")
    if not gastos:
        print("No hay gastos registrados para filtrar.")
        return

    categoria_buscada = pedir_texto_no_vacio("Ingresa la categoría a buscar: ").capitalize()
    encontrados = [g for g in gastos if g["categoria"] == categoria_buscada]

    if not encontrados:
        print(f"No se encontraron gastos en la categoría '{categoria_buscada}'.")
        return

    print(f"\nGastos en '{categoria_buscada}':")
    for indice, gasto in enumerate(encontrados, start=1):
        print(f"{indice}. {gasto['descripcion']} - ${gasto['monto']:.2f}")


def calcular_resumen(gastos):
    print("\n--- RESUMEN DE GASTOS ---")
    if not gastos:
        print("No hay datos suficientes para generar un resumen.")
        return

    total_general = 0.0
    totales_por_categoria = {}

    for gasto in gastos:
        monto = gasto["monto"]
        categoria = gasto["categoria"]

        total_general += monto
     
        totales_por_categoria[categoria] = totales_por_categoria.get(categoria, 0.0) + monto

    print(f"Total general: ${total_general:.2f}\n")
    print("Desglose por categoría:")
    for categoria, subtotal in totales_por_categoria.items():
        print(f"- {categoria}: ${subtotal:.2f}")


def mostrar_menu():
    print("\n=== GESTOR DE GASTOS ===")
    print("1. Registrar gasto")
    print("2. Ver todos los gastos")
    print("3. Filtrar por categoría")
    print("4. Ver resumen total")
    print("5. Salir")


def main():
    lista_gastos = []

    while True:
        mostrar_menu()
        opcion = input("Elige una opción: ").strip()

        if opcion == "1":
            agregar_gasto(lista_gastos)
        elif opcion == "2":
            mostrar_gastos(lista_gastos)
        elif opcion == "3":
            filtrar_por_categoria(lista_gastos)
        elif opcion == "4":
            calcular_resumen(lista_gastos)
        elif opcion == "5":
            print("\n¡Gracias por usar el Gestor de Gastos! Hasta pronto.")
            break
        else:
            print("Error: Opción no válida. Por favor, elige un número del 1 al 5.")


if __name__ == "__main__":
    main()
